rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && isAdmin();
    }

    match /newsrooms/main {
      allow get: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['stories', 'sources', 'version'])
        && request.resource.data.stories is list
        && request.resource.data.sources is list
        && request.resource.data.version is string;
    }
  }
}
